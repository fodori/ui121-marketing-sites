---
import { story } from '../content/story'
---

<section id="product" class="px-6 py-20">
  <div class="mx-auto max-w-6xl rounded-[2rem] border border-line bg-white p-8 shadow-sm md:p-12">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cobalt">The problem</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-night md:text-4xl">{story.problemTitle}</h2>
        <p class="mt-4 text-soft leading-relaxed">{story.problemBody}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-signal">The product</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-night md:text-4xl">{story.solutionTitle}</h2>
        <p class="mt-4 text-soft leading-relaxed">{story.solutionBody}</p>
      </div>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        story.proofPoints.map((point) => (
          <li class="rounded-2xl border border-line bg-paper px-5 py-4 text-sm font-medium text-night">{point}</li>
        ))
      }
    </ul>
  </div>
</section>
