---
import { useCases } from '../content/useCases'

const accents = ['ember', 'voltage', 'ember', 'voltage', 'ember', 'voltage', 'ember', 'voltage'] as const
---

<section id="use-cases" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-ember">Use cases</p>
    <h2 class="mt-3 max-w-2xl font-display text-4xl font-bold tracking-tight text-mist md:text-5xl">
      Where machines stall — and how humans finish the step
    </h2>
    <div class="mt-14 space-y-8">
      {
        useCases.map((uc, i) => (
          <article
            class:list={[
              'grid overflow-hidden rounded-3xl border border-white/10 bg-slate/40 md:grid-cols-[0.9fr_1.1fr]',
              i % 2 === 1 && 'md:[&>*:first-child]:order-2',
            ]}
          >
            <div
              class:list={[
                'relative min-h-[220px] p-8',
                accents[i] === 'ember'
                  ? 'bg-gradient-to-br from-ember/25 to-ink'
                  : 'bg-gradient-to-br from-voltage/20 to-ink',
              ]}
            >
              <div class="absolute inset-6 rounded-2xl border border-white/10 bg-ink/40 backdrop-blur-sm" />
              <div class="relative flex h-full flex-col justify-between">
                <p class="font-mono text-xs uppercase tracking-widest text-hush">{uc.mediaHint}</p>
                <p class="font-display text-3xl font-bold text-mist">{String(i + 1).padStart(2, '0')}</p>
                <div class="h-1 w-24 rounded-full bg-gradient-to-r from-ember to-voltage" />
              </div>
            </div>
            <div class="p-8 md:p-10">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-hush">{uc.audience}</p>
              <h3 class="mt-2 font-display text-2xl font-bold text-mist md:text-3xl">{uc.title}</h3>
              <div class="mt-6 space-y-4 text-sm leading-relaxed text-hush md:text-base">
                <p>
                  <span class="font-semibold text-ember">Problem. </span>
                  {uc.problem}
                </p>
                <p>
                  <span class="font-semibold text-voltage">How we solve it. </span>
                  {uc.howWeSolve}
                </p>
                <p>
                  <span class="font-semibold text-mist">Why better. </span>
                  {uc.whyBetter}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
