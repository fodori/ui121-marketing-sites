---
import { LeadForm } from '@ui121-marketing/lead-form'
import site from '../../site.config'
---

<section id="contact" class="px-6 py-20">
  <div class="mx-auto grid max-w-6xl gap-10 rounded-[2rem] border border-line bg-white p-8 md:grid-cols-2 md:p-12">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cobalt">Contact</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-night">Talk to UI121</h2>
      <p class="mt-4 text-soft">Tell us about your human-in-the-loop needs. Or jump straight into the product.</p>
      <a
        href="https://app.ui121.com"
        class="mt-6 inline-flex rounded-full bg-cobalt px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Open app.ui121.com
      </a>
    </div>
    <div class="company-lead">
      <LeadForm
        client:visible
        siteId={site.leadForm.siteId ?? site.domain}
        collection={site.leadForm.collection}
        submitLabel="Send message"
        successMessage="Thanks — the UI121 team will follow up."
        className="company-lead-form"
      />
    </div>
  </div>
</section>

<style>
  :global(.company-lead-form) {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  :global(.company-lead-form label) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: #0c1222;
  }
  :global(.company-lead-form input) {
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
    background: #f7f5f0;
    padding: 0.75rem 1rem;
  }
  :global(.company-lead-form button) {
    margin-top: 0.35rem;
    border-radius: 9999px;
    background: #1d4ed8;
    color: #fff;
    font-weight: 600;
    padding: 0.8rem 1.2rem;
  }
</style>
