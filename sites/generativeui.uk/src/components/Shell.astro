---
import site from '../../site.config'
import { story } from '../content/story'
import { useCases } from '../content/useCases'
---

<header class="border-b border-white/10 px-6 py-4">
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="font-display text-lg font-bold">{site.name}</a>
    <a href={site.primaryCta.href} class="rounded-full bg-accent px-4 py-2 text-sm font-semibold text-canvas"
      >{site.primaryCta.label}</a
    >
  </div>
</header>
<section class="mx-auto grid max-w-5xl gap-10 px-6 py-16 md:grid-cols-2 md:items-center">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">AI-native · API-first</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight md:text-5xl">{site.tagline}</h1>
    <p class="mt-4 text-muted">{site.seo.description}</p>
  </div>
  <div class="rounded-2xl border border-white/10 bg-panel p-6">
    <p class="text-sm text-muted">Scaffold landing</p>
    <p class="mt-2 font-display text-2xl font-bold">Content editable via site.config + src/content</p>
  </div>
</section>
<section id="overview" class="border-y border-white/10 bg-panel/60 px-6 py-16">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold">{story.solutionTitle}</h2>
    <p class="mt-4 max-w-3xl text-muted">{story.solutionBody}</p>
    <ul class="mt-8 grid gap-3 md:grid-cols-3">
      {story.proofPoints.map((p) => <li class="rounded-xl border border-white/10 bg-canvas/50 p-4 text-sm">{p}</li>)}
    </ul>
  </div>
</section>
<section id="use-cases" class="px-6 py-16">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold">Use cases</h2>
    <div class="mt-8 grid gap-4">
      {
        useCases.map((uc) => (
          <article class="rounded-2xl border border-white/10 bg-panel p-6">
            <h3 class="font-display text-xl font-bold">{uc.title}</h3>
            <p class="mt-2 text-sm text-muted">
              <span class="text-accent">Problem.</span> {uc.problem}
            </p>
            <p class="mt-2 text-sm text-muted">
              <span class="text-accent">Solve.</span> {uc.howWeSolve}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
<footer class="border-t border-white/10 px-6 py-8 text-sm text-muted">
  <div class="mx-auto max-w-5xl">
    © {new Date().getFullYear()}
    {site.name}. Scaffold landing — content editable anytime.
  </div>
</footer>
