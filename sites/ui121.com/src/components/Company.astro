---
import site from '../../site.config'
---

<section id="company" class="px-6 py-16">
  <div
    class="mx-auto grid max-w-6xl gap-8 rounded-[2rem] bg-night px-8 py-12 text-white md:grid-cols-[1.2fr_0.8fr] md:px-12"
  >
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-signal">Company</p>
      <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">{site.companyLegal}</h2>
      <p class="mt-4 max-w-xl text-slate-300 leading-relaxed">
        We build the human interface for AI-augmented operations — a safe channel between machines and people. The
        product lives at <a class="text-signal underline-offset-2 hover:underline" href="https://app.ui121.com"
          >app.ui121.com</a
        >.
      </p>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <p class="text-sm font-semibold text-signal">What we believe</p>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        <li>Humans should see controlled surfaces — not unbounded generated HTML.</li>
        <li>Agents and backends deserve an API-first path to ask people for help.</li>
        <li>Real-time when online; resilient when the network fails.</li>
      </ul>
    </div>
  </div>
</section>
