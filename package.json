{
  "name": "ui121-marketing-sites",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "site:dev": "node scripts/dev.mjs",
    "site:build": "node scripts/build.mjs",
    "site:preview": "node scripts/preview.mjs",
    "site:check": "node scripts/check.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint --cache --fix",
    "type-check": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "yarn format:check && yarn lint && yarn type-check && yarn test"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22",
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "yarn lint:fix",
      "prettier --write"
    ],
    "*.{astro,md,json,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
