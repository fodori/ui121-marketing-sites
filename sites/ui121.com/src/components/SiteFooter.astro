---
import site from '../../site.config'
---

<footer class="border-t border-line bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-12 text-sm text-soft md:flex-row md:items-center md:justify-between"
  >
    <div>
      <p class="font-semibold text-night">{site.companyLegal ?? 'UI121 Ltd'}</p>
      <p class="mt-1">Real-time human–machine interface for AI-augmented operations.</p>
    </div>
    <div class="flex flex-wrap gap-4">
      {
        site.footerLinks.map((l) => (
          <a class="hover:text-night" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
