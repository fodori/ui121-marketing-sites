---
import site from '../../site.config'
---

<section class="relative overflow-hidden px-6 pb-20 pt-16 md:pt-24">
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
    <div>
      <p
        class="mb-4 inline-flex rounded-full border border-line bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-cobalt"
      >
        UI121 Ltd · AI-native
      </p>
      <h1 class="font-display text-5xl font-extrabold leading-[1.05] tracking-tight text-night md:text-6xl">
        {site.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-soft">
        Connect agents, backends, and workflows with real humans through controlled, dynamic UIs. Structured answers in.
        Automation continues.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={site.primaryCta.href}
          class="rounded-full bg-cobalt px-6 py-3 font-semibold text-white shadow-xl shadow-cobalt/30 hover:bg-blue-700"
        >
          {site.primaryCta.label}
        </a>
        {
          site.secondaryCta && (
            <a
              href={site.secondaryCta.href}
              class="rounded-full border border-line bg-white px-6 py-3 font-semibold text-night hover:border-cobalt/40"
            >
              {site.secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
    <div class="relative">
      <div
        class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-cobalt/15 via-signal/10 to-transparent blur-2xl"
      >
      </div>
      <div class="float-card relative rounded-[1.75rem] border border-line bg-white p-5 shadow-2xl shadow-night/10">
        <div class="mb-4 flex items-center justify-between">
          <p class="text-sm font-semibold text-night">Task inbox</p>
          <span class="rounded-full bg-signal/15 px-2 py-0.5 text-xs font-semibold text-sky-700">live</span>
        </div>
        <div class="space-y-3">
          <div class="rounded-2xl border border-line bg-paper p-4">
            <p class="text-sm font-semibold text-night">Approve high-value transfer</p>
            <p class="mt-1 text-xs text-soft">From finance agent · needs human gate</p>
          </div>
          <div class="rounded-2xl border border-cobalt/20 bg-cobalt/5 p-4">
            <p class="text-sm font-semibold text-night">Capture site photo + serial</p>
            <p class="mt-1 text-xs text-soft">Field task · offline-capable</p>
          </div>
          <div class="rounded-2xl border border-line bg-paper p-4">
            <p class="text-sm font-semibold text-night">Review AI classification</p>
            <p class="mt-1 text-xs text-soft">Expert review · structured outcome</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
