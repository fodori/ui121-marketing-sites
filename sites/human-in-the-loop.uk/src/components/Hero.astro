---
import site from '../../site.config'
---

<section class="relative overflow-hidden px-6 pb-24 pt-20 md:pt-28">
  <div class="pointer-events-none absolute inset-0">
    <div class="anim-pulse absolute left-1/2 top-24 h-72 w-72 -translate-x-1/2 rounded-full bg-ember/20 blur-3xl"></div>
    <div class="absolute right-[10%] top-40 h-40 w-40 rounded-full bg-voltage/10 blur-2xl"></div>
  </div>
  <div class="relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
    <div>
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-voltage">
        AI-native · real-time · API-first
      </p>
      <h1 class="font-display text-5xl font-extrabold leading-[0.95] tracking-tightest text-mist md:text-7xl">
        {site.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-hush md:text-xl">
        When agents and workflows need judgment, approval, or missing data — send a controlled UI to a human and get
        structured answers back.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={site.primaryCta.href}
          class="rounded-full bg-ember px-6 py-3 font-semibold text-ink shadow-[0_0_40px_rgba(255,92,51,0.4)] hover:brightness-110"
        >
          {site.primaryCta.label}
        </a>
        {
          site.secondaryCta && (
            <a
              href={site.secondaryCta.href}
              class="rounded-full border border-white/20 px-6 py-3 font-semibold text-mist hover:border-voltage/60 hover:text-voltage"
            >
              {site.secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
    <div class="relative rounded-3xl border border-white/10 bg-slate/60 p-6 shadow-2xl backdrop-blur">
      <div class="mb-4 flex items-center justify-between text-xs uppercase tracking-widest text-hush">
        <span>Live handoff</span>
        <span class="text-voltage">realtime</span>
      </div>
      <div class="space-y-3 font-mono text-sm">
        <div class="rounded-xl border border-ember/30 bg-ink/60 p-4">
          <p class="text-ember">agent → needs approval</p>
          <p class="mt-1 text-hush">transfer.amount = 48_200</p>
        </div>
        <div class="relative h-8 overflow-hidden rounded-full bg-white/5">
          <div
            class="anim-beam absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-transparent via-voltage to-transparent"
          >
          </div>
        </div>
        <div class="rounded-xl border border-voltage/30 bg-ink/60 p-4">
          <p class="text-voltage">human → structured yes</p>
          <p class="mt-1 text-hush">decision = approve · reason = policy_ok</p>
        </div>
      </div>
    </div>
  </div>
</section>
