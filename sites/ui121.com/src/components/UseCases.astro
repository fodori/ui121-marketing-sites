---
import { useCases } from '../content/useCases'
---

<section id="use-cases" class="px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cobalt">Use cases</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-night">Where UI121 fits</h2>
      <p class="mt-4 text-soft">
        Eight places teams use a programmable human surface instead of chat dumps or custom apps.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        useCases.map((uc, i) => (
          <article class="flex flex-col rounded-3xl border border-line bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="mb-4 flex h-28 items-end rounded-2xl bg-gradient-to-br from-cobalt/10 via-white to-signal/10 p-4">
              <span class="font-display text-3xl font-bold text-cobalt/40">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-soft">{uc.audience}</p>
            <h3 class="mt-2 font-display text-xl font-bold text-night">{uc.title}</h3>
            <p class="mt-4 text-sm text-soft">
              <span class="font-semibold text-night">Problem. </span>
              {uc.problem}
            </p>
            <p class="mt-3 text-sm text-soft">
              <span class="font-semibold text-night">How UI121 helps. </span>
              {uc.howWeSolve}
            </p>
            <p class="mt-3 text-sm text-soft">
              <span class="font-semibold text-cobalt">Why better. </span>
              {uc.whyBetter}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
