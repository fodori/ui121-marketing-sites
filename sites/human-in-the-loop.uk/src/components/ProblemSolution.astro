---
import { story } from '../content/story'
---

<section id="problem" class="px-6 py-20">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-ember">The problem</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-mist md:text-5xl">{story.problemTitle}</h2>
    </div>
    <p class="text-lg leading-relaxed text-hush md:pt-8">{story.problemBody}</p>
  </div>
</section>

<section id="solution" class="border-y border-white/10 bg-slate/30 px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-voltage">The solution</p>
    <h2 class="mt-3 max-w-3xl font-display text-4xl font-bold tracking-tight text-mist md:text-5xl">
      {story.solutionTitle}
    </h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-hush">{story.solutionBody}</p>
    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {
        story.proofPoints.map((point) => (
          <li class="rounded-2xl border border-white/10 bg-ink/50 p-5 text-mist">
            <span class="mr-2 text-ember">▹</span>
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</section>
